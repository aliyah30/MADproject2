rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User avatars — only the owner can write, any auth user can read
    match /avatars/{uid}.jpg {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024   // 5 MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Trip assets (covers + activity images)
    // Any trip member can read; any auth user can write (trip membership
    // is enforced at the Firestore level when the URL is saved)
    match /trips/{tripId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB max
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
